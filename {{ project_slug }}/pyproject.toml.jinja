[project]
name = "{{ project_slug }}"
dynamic = ["version"]
requires-python = ">={{ python_version }}"
authors = [
    { name = "{{ author_name }}" }
]
description = "{{ description }}"
dependencies = [
    "matplotlib>=3.11.2",
    "numpy>=2.5.3",
    "pandas>=3.0.6",
]

[dependency-groups]
dev = [
    "ipykernel>=7.4.0",
    "pre-commit>=4.6.2",
    "pytest>=9.1.1",
    "ruff>=0.16.10",
]

[build-system]
requires = ["hatchling"]
build-backend = "hatchling.build"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ package_name }}"]

[tool.hatch.version]
path = "src/{{ package_name }}/__init__.py"

[tool.ruff]
line-length = 100
target-version = "py{{ python_version.split('.')[0] }}{{ python_version.split('.')[1] }}"
exclude = [
    ".venv",
    "dist",
    "build",
    "__pycache__",
    ".git",
    "data",
]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"

[tool.ruff.lint]
select = [
    "E",   # pycodestyle errors
    "F",   # pyflakes
    "I",   # import sorting
    "B",   # bugbear
    "UP",  # pyupgrade
]

[tool.ruff.lint.isort]
known-first-party = ["{{ package_name }}"]
